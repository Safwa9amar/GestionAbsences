{ ==========================================================================
  الواجهة البرمجية / API
  ========================================================================== }
procedure SetLanguage(ALang: TAppLang);
begin
  FLang := ALang;
  if ALang = langFR then
    LoadFrench
  else
    LoadArabic;
end;

procedure SetLanguageByCode(const ACode: string);
begin
  if SameText(Trim(ACode), 'FR') then
    SetLanguage(langFR)
  else
    SetLanguage(langAR);
end;

function CurrentLang: TAppLang;
begin
  Result := FLang;
end;

function LangCode: string;
begin
  if FLang = langFR then
    Result := 'FR'
  else
    Result := 'AR';
end;

function IsRTL: Boolean;
begin
  { العربية من اليمين إلى اليسار، الفرنسية من اليسار إلى اليمين }
  Result := FLang = langAR;
end;

function LangDisplayName(ALang: TAppLang): string;
begin
  if ALang = langFR then
    Result := R_LangFrench
  else
    Result := R_LangArabic;
end;

initialization
  { ضمان امتلاء النصوص قبل إنشاء أي نافذة }
  SetLanguage(langAR);

end.
